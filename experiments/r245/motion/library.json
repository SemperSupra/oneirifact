    "implemented": [
      "deterministic seek and phase",
      "travelling loop root delta",
      "authored sit_to_stand transition",
      "masked upper-body additive intent"
    ],
    "unsupported": [
      "arbitrary contact-aware clip crossfade",
      "terrain or stairs",
      "obstacle avoidance",
      "ground reaction forces",
      "balance controller",
      "water or wet-contact mechanics",
      "learned age or gender gait inference"
    ]
  },
